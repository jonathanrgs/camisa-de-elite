// ============================================
// CUPONS DE DESCONTO
// ============================================
model Coupon {
  id         String   @id @default(cuid())
  code       String   @unique
  type       String   // percent, fixed, free_shipping
  value      Float
  minTotal   Float    @default(0)
  isActive   Boolean  @default(true) // Ativo ou inativo manualmente
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders     Order[]
  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])
  orderId   String?
  order     Order?  @relation(fields: [orderId], references: [id])
  redeemedAt DateTime @default(now())
}
// Schema Prisma - Camisa de Elite
// Usando SQLite para desenvolvimento (sem necessidade de instalar banco)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CONFIGURAÇÃO DE FRETE
// ============================================
model ShippingConfig {
  id            String   @id @default(cuid())
  freeShippingMin Float   // Valor mínimo para frete grátis
  fixedShipping   Float   // Frete fixo padrão
  cityRules       String  // JSON: [{city, state, type: 'fixed'|'km', value, kmRadius}]
  originCep       String?
  originNumber    String?
  radiusKm        Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
// USUÁRIOS
// ============================================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  phone        String?
  password     String
  role         String   @default("CUSTOMER") // ADMIN, CUSTOMER
  favoriteTeam String?  // Time do coração
  address      String?
  neighborhood String?
  number       String?
  complement   String?
  city         String?
  state        String?
  zipCode      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders  Order[]
  reviews Review[]
  couponRedemptions CouponRedemption[]
}

// ============================================
// PRODUTOS
// ============================================
model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Float
  images      String   // JSON array de URLs
  category    String   // NACIONAL, INTERNACIONAL, RETRO, SELECAO
  team        String
  league      String?
  country     String?
  state       String?
  city        String?
  season      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory Inventory?
  orderItems OrderItem[]
  reviews   Review[]
}

// ============================================
// INVENTÁRIO / ESTOQUE
// ============================================
model Inventory {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // Estoque por tamanho (armazenado como JSON)
  stock     String   // JSON: {"P": 10, "M": 15, "G": 20, "XL": 5, "2XL": 2, "3XL": 1, "4XL": 0}
  
  lowStockThreshold Int @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alerts StockAlert[]
}

// ============================================
// ALERTAS DE ESTOQUE
// ============================================
model StockAlert {
  id          String   @id @default(cuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  size        String   // P, M, G, XL, 2XL, 3XL, 4XL
  currentQty  Int
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ============================================
// PEDIDOS
// ============================================
model Order {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  
  customerName  String
  customerPhone String
  customerEmail String?
  
  items        OrderItem[]
  totalAmount  Float
  discountAmount Float? // Valor do desconto aplicado (opcional)
  discountedTotal Float? // Total já com desconto aplicado (opcional)
  status       String   @default("PENDENTE") // PENDENTE, CONFIRMADO, EM_ROTA, ENVIADO, ENTREGUE, CANCELADO
  couponId     String?
  coupon       Coupon?  @relation(fields: [couponId], references: [id])
  
  // Dados de entrega
  address      String?
  neighborhood String?
  number       String?
  complement   String?
  city         String?
  state        String?
  zipCode      String?
  
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orderLink    OrderLink?
  couponRedemptions CouponRedemption[]
}

// ============================================
// ITENS DO PEDIDO
// ============================================
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  
  size      String   // P, M, G, XL, 2XL, 3XL, 4XL
  quantity  Int
  unitPrice Float
  
  // Personalização
  customName   String?
  customNumber String?
  
  createdAt DateTime @default(now())
}

// ============================================
// LINK DE PEDIDO (com expiração)
// ============================================
model OrderLink {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============================================
// AVALIAÇÕES
// ============================================
model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  
  authorName String
  rating     Int      // 1-5
  comment    String?
  isApproved Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// RESERVAS DE CARRINHO (Estoque Pendente)
// ============================================
model CartReservation {
  id          String   @id @default(cuid())
  sessionId   String   // Identificador único do carrinho (localStorage ou usuário)
  productId   String
  size        String   // P, M, G, XL, 2XL, 3XL, 4XL
  quantity    Int
  expiresAt   DateTime // Expira em 30 minutos de inatividade
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sessionId, productId, size])
  @@index([expiresAt])
  @@index([sessionId])
}
